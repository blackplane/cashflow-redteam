# LiteLLM reads provider-specific keys. Set the ones for the models in configs/experiment.yaml.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: route everything through a LiteLLM proxy / OpenAI-compatible endpoint instead.
# When set, it is passed to litellm as api_base for every model.
LITELLM_API_BASE=
LITELLM_API_KEY=
